node_modules/
# npm troubleshooting sometimes leaves a sibling install here (node_modules_tmp_ajv
# and friends). It is vendored third-party code, not source: keep it out of git and
# out of eslint, which otherwise reports its CommonJS as errors in our own lint run.
node_modules_tmp*/
dist/
build/
*.log
*.tsbuildinfo
.DS_Store
.env
.env.local
.vscode/
.idea/

# CLI runtime artifacts
**/.dvload/
checkpoints/
logs/

# Add-in dev certs
.office-addin-dev-certs/

# Generated load-test data (make-load-data.js)
tests/dummy-data/contacts_*.xlsx
tests/dummy-data/contacts_*.csv
tests/dummy-data/edge-cases.xlsx

# Test & quality tooling output
coverage/
reports/
.stryker-tmp/
*.tsbuildinfo
publish/
