{
  "schemaVersion": 1,
  "name": "Load test — upsert + skipUnchanged",
  "description": "Upsert-mode mapping keyed on emailaddress1. Requires an alternate key on contact.emailaddress1 in the target environment (see TEST-PROTOCOL.md §2). Edit environmentUrl before use.",
  "environmentUrl": "https://YOURORG.crm.dynamics.com",
  "targetEntitySet": "contacts",
  "sourceTable": "tblContacts",
  "conflictMode": "upsert",
  "upsertKey": ["emailaddress1"],
  "skipUnchanged": true,
  "batchSize": 500,
  "maxErrors": 100,
  "logDir": "./logs",
  "columns": [
    { "source": "First Name",   "target": "firstname",     "kind": "string",   "treatEmptyAsNull": true },
    { "source": "Last Name",    "target": "lastname",      "kind": "string",   "treatEmptyAsNull": true },
    { "source": "Email",        "target": "emailaddress1", "kind": "string",   "treatEmptyAsNull": true },
    { "source": "Job Title",    "target": "jobtitle",      "kind": "string",   "treatEmptyAsNull": true },
    { "source": "Birthday",     "target": "birthdate",     "kind": "dateonly", "treatEmptyAsNull": true },
    { "source": "Credit Limit", "target": "creditlimit",   "kind": "money",    "treatEmptyAsNull": true },
    { "source": "Do Not Email", "target": "donotemail",    "kind": "boolean",  "treatEmptyAsNull": true },
    { "source": "Notes",        "target": "description",   "kind": "memo",     "treatEmptyAsNull": true }
  ]
}
