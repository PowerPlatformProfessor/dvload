{
  "name": "dvload",
  "version": "0.1.0",
  "type": "module",
  "description": "Load Excel/Power Query tables into Microsoft Dataverse from the command line. Schedules via Windows Task Scheduler.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PowerPlatformProfessor/dvload.git"
  },
  "keywords": [
    "dataverse",
    "dynamics-365",
    "power-platform",
    "excel",
    "power-query",
    "odata",
    "etl",
    "import"
  ],
  "bin": {
    "dvload": "build/dvload.cjs"
  },
  "files": [
    "build/dvload.cjs",
    "build/web"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "node scripts/bundle.mjs",
    "prepublishOnly": "npm run build && npm run bundle",
    "clean": "rimraf dist build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --root ../.. --project cli"
  },
  "devDependencies": {
    "@azure/msal-node": "^2.6.0",
    "@dvload/core": "0.1.0",
    "commander": "^12.0.0",
    "esbuild": "^0.28.2",
    "kleur": "^4.1.5",
    "tsx": "^4.23.12"
  }
}
