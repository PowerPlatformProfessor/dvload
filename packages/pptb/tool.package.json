{
  "name": "@dvload/pptb",
  "version": "0.1.0",
  "displayName": "dvload — Excel to Dataverse",
  "description": "Map an Excel table or CSV (typically a Power Query output) to a Dataverse table and load it: column mapping with suggestions, lookup resolution by GUID / alternate key / text, insert / upsert / skip / sync modes, dry runs, resumable imports, and dataflow import.",
