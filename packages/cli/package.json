{
  "name": "@dvload/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Run a saved .dvmap.json against Dataverse from the command line. Schedules via Windows Task Scheduler.",
  "bin": {
    "dvload": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --test --import tsx \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@azure/msal-node": "^2.6.0",
    "@dvload/core": "0.1.0",
    "commander": "^12.0.0",
    "keytar": "^7.9.0",
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "tsx": "^4.7.0"
  }
}
